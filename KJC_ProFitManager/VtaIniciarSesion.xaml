<Window x:Class="KJC_ProFitManager.VtaIniciarSesion"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:KJC_ProFitManager"
        mc:Ignorable="d"
        Title="Iniciar Sesión" Height="400" Width="500"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        WindowStyle="None">
    <Grid Background="#FF222831">
        <Border Background="#FFEEEEEE" CornerRadius="10" Padding="20" HorizontalAlignment="Center" VerticalAlignment="Center" Width="350">
            <StackPanel>
                <TextBlock Text="Inicio de Sesión" 
                           FontSize="22" FontWeight="Bold" 
                           HorizontalAlignment="Center" Margin="0,0,0,20"/>

                <TextBlock Text="Correo:"/>
                <TextBox x:Name="txtCorreo" Margin="0,0,0,10" Height="30" Padding="5"/>

                <TextBlock Text="Contraseña:"/>
                <PasswordBox x:Name="txtContrasena" Margin="0,0,0,20" Height="30" Padding="5"/>

                <Button Content="Iniciar Sesión" Click="BtnIniciarSesion_Click"
                        Background="#FF00ADB5" Foreground="White" FontWeight="Bold"
                        Height="35" Margin="0,0,0,10"/>

                <Button Content="Regresar" Click="btnRegresar_Click"
                        Background="Gray" Foreground="White" Height="35"/>

                <TextBlock x:Name="lblError" Foreground="Red" TextAlignment="Center" Margin="0,10,0,0"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
