<Window x:Class="KJC_ProFitManager.VtaMenuPrincipal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:KJC_ProFitManager"
        mc:Ignorable="d"
        Title="Menú Principal" Height="400" Width="600"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        WindowStyle="None">
    <Grid>
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
            <TextBlock x:Name="lblBienvenida" FontSize="22" FontWeight="Bold" Margin="0,0,0,20" TextAlignment="Center"/>
            <Button Content="Cerrar Sesión" Width="150" Height="40" Click="BtnCerrarSesion_Click"/>
        </StackPanel>
    </Grid>
</Window>
